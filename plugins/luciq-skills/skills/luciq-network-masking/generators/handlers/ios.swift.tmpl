    // Recursive field-name redactor: replaces any key in bodyFields with "***"
    // at any nesting depth. Reused by request and response.
    private static func redactFields(_ node: Any) -> Any {
        if let arr = node as? [Any] { return arr.map { redactFields($0) } }
        if let obj = node as? [String: Any] {
            var out: [String: Any] = [:]
            for (k, v) in obj {
