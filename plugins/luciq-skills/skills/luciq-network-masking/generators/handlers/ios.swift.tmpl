        case .removeAll:
            return Data("{\"redacted\":true}".utf8)
        case .removeSensitive:
            guard let obj = try? JSONSerialization.jsonObject(with: body) else { return body }
            return (try? JSONSerialization.data(withJSONObject: redactFields(obj))) ?? body
        }
    }

    private static func scrubURL(_ url: URL?) -> URL? {
        guard let url = url else { return nil }
        switch mode {
        case .removeAll:
            var c = URLComponents(url: url, resolvingAgainstBaseURL: false)
            c?.path = "/***"; c?.query = nil
            return c?.url ?? url
