import org.json.JSONArray
import org.json.JSONObject

enum class ScrubMode { REMOVE_SENSITIVE, REMOVE_ALL }

object Manifest {
    // __BODY_FIELDS__  (lowercased)
    val bodyFields: Set<String> = setOf(__BODY_FIELDS__)
    // __PATH_PATTERNS__  (regex)
    val pathPatterns: List<Regex> = listOf(__PATH_PATTERNS__)
}

// Recursive field-name redactor over an org.json tree.
fun redactFields(node: Any?, fields: Set<String>): Any? = when (node) {
    is JSONObject -> JSONObject().also { out ->
        for (k in node.keys()) {
            out.put(k, if (k.lowercase() in fields) "***" else redactFields(node.get(k), fields))
        }
    }
    is JSONArray -> JSONArray().also { out ->
        for (i in 0 until node.length()) out.put(redactFields(node.get(i), fields))
    }
    else -> node
}

fun scrubBody(body: String?, mode: ScrubMode, m: Manifest): String = when (mode) {
    ScrubMode.REMOVE_ALL -> ""
    ScrubMode.REMOVE_SENSITIVE -> body?.let {
        try { redactFields(JSONObject(it), m.bodyFields).toString() } catch (e: Exception) { it }
    } ?: ""
}

fun scrubPath(url: String, mode: ScrubMode, m: Manifest): String = when (mode) {
    ScrubMode.REMOVE_ALL ->
        url.toHttpUrlOrNull()?.let { "${it.scheme}://${it.host}/***" } ?: "***"
    ScrubMode.REMOVE_SENSITIVE ->
        m.pathPatterns.fold(url) { acc, rx -> rx.replace(acc, "***") }
}

fun scrubPII(d: LuciqNetworkLog, mode: ScrubMode, m: Manifest): LuciqNetworkLog {
    d.url = scrubPath(d.url, mode, m)
    d.requestBody = scrubBody(d.requestBody, mode, m)
    d.responseBody = scrubBody(d.responseBody, mode, m)
    return d
}

// --- Wiring: inside the LuciqNetworkLog listener on LuciqOkhttpInterceptor.
// The active mode comes from YOUR feature-flag system (CustomerFlags), so the
// REMOVE_ALL incident flip needs no app release.
fun onNetworkLog(log: LuciqNetworkLog) {
    scrubPII(log, CustomerFlags.networkScrubMode, Manifest)
}
